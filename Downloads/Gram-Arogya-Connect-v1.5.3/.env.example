PORT=4000
CLIENT_ORIGIN=*
NODE_ENV=development

# --- MongoDB ---
# Local dev default already points at a local Mongo. For production, use
# a MongoDB Atlas (or similar managed) connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/gram_arogya_connect_v15

# --- Field-level encryption (patient records) ---
# 64-char hex string (32 raw bytes) required for AES-256.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left blank, the server will still run (using a random per-process
# key) but encrypted data will NOT survive a restart — set this for real
# deployments.
ENCRYPTION_KEY=

# --- HTTPS (optional) ---
# Only used if BOTH paths are set and the files exist; otherwise the
# server runs on plain HTTP. For local dev you can generate a self-signed
# pair with:
#   openssl req -x509 -newkey rsa:2048 -nodes -keyout key.pem -out cert.pem -days 365
SSL_KEY_PATH=
SSL_CERT_PATH=

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120
SOS_RATE_LIMIT_PER_MINUTE=10
